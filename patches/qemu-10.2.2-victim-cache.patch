--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -27,7 +27,22 @@
     struct {
         TranslationBlock *tb;
         vaddr pc;
-    } array[TB_JMP_CACHE_SIZE];
+    } array[TB_JMP_CACHE_SIZE], victim[TB_JMP_CACHE_SIZE];
 } CPUJumpCache;
 
+/* Keep the displaced entry as a second chance at the same page-local index.
+ * Every invalidation path must clear BOTH arrays. Valid entries are populated
+ * only by the owning CPU; other CPUs may atomically invalidate their TBs. */
+static inline void tb_jmp_cache_set(CPUJumpCache *jc, unsigned hash,
+                                  vaddr pc, TranslationBlock *tb)
+{
+    TranslationBlock *old = qatomic_read(&jc->array[hash].tb);
+    if (old) {
+        jc->victim[hash].pc = jc->array[hash].pc;
+        qatomic_set(&jc->victim[hash].tb, old);
+    }
+    jc->array[hash].pc = pc;
+    qatomic_set(&jc->array[hash].tb, tb);
+}
+
